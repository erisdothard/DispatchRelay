# ─────────────────────────────────────────────
# FreightX Environment Variables
# ─────────────────────────────────────────────
# Copy this file to apps/web/.env.local
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Supabase (required)
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://qeovhjdrwihnyfcbnujk.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-key

# Stripe (required for Phase 5+)
# Get from: dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# FMCSA API (required for Phase 5 carrier verification)
# Register free at: portal.fmcsa.dot.gov/Developer/
VITE_FMCSA_API_KEY=

# Google Maps (optional — for map-based search views)
# Get from: console.cloud.google.com
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (optional — for error monitoring in production)
# Get from: sentry.io → your project → Settings → DSN
VITE_SENTRY_DSN=

# App URL (used for OAuth redirects, email links)
VITE_APP_URL=http://localhost:5173

# Upstash Redis (required for Phase 6.5+ rate limiting)
# Sign up at: https://upstash.com (free tier available)
VITE_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-token-here

# Anthropic API (required for AI load search — supabase/functions/ai-load-search)
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here